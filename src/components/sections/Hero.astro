---
/**
 * Homepage hero (template: hero-section hero-1).
 * Portrait is vertically centered so the space above and below it matches.
 * Navy-dominant: background photo (slot `hero-bg`) under a navy overlay, white copy on the left,
 * a transparent cutout of Dr. Tau (slot `hero`) standing on the bottom edge at right.
 * Without a background photo it falls back to a solid navy field with a soft blue glow.
 */
import Button from '../site/Button.astro';
import { photo } from '../../lib/photo';
import photos from '../../data/photos.json';
interface Props { data: { kicker: string; title_before: string; title_bold: string; title_after: string; text: string; cta: { label: string; href: string }; proof: { count: number | string; suffix: string; label: string }} }
const { data: d } = Astro.props;
const img = photo('hero');
const bg = photos['hero-bg'].src;
const cutout = !!(photos.hero as { cutout?: boolean }).cutout; // cutouts stand on the bottom edge; framed photos are centered
---
<section class:list={['hero-section hero-1 fix dlt-hero', cutout && 'dlt-hero--cutout']} style={bg ? `--hero-bg: url('${bg}')` : undefined} data-bg={bg ? 'photo' : 'none'}>
  <div class="dlt-hero__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-6 d-flex align-items-center">
        <div class="hero-content">
          <h6 class="wow fadeInUp">{d.kicker}</h6>
          <h1>{d.title_before} <b>{d.title_bold}</b> {d.title_after}</h1>
          <p class="wow fadeInUp" data-wow-delay=".3s">{d.text}</p>
          <Button label={d.cta.label} href={d.cta.href} variant="mist" class="wow fadeInUp" delay=".5s" />
          <div class="hero-info wow fadeInUp" data-wow-delay=".7s">
            <div class="info-content">
              <h3><span class="count">{d.proof.count}</span><span class="dlt-suffix">{d.proof.suffix}</span></h3>
              <p>{d.proof.label}</p>
            </div>
          </div>
        </div>
      </div>
      <div class:list={['col-lg-6 d-flex', cutout ? 'align-items-end' : 'align-items-center']}>
        <div class="hero-image">
          <img src={img.src} alt={img.alt} width={img.width} height={img.height} />
        </div>
      </div>
    </div>
  </div>
</section>
