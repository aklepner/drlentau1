---
/** Heading left, paragraphs right. For story and long-form copy. (Custom section, styled in tau-theme.css.) */
import Button from '../site/Button.astro';
interface Props { data: { kicker?: string; title: string; lead?: string; paragraphs: string[]; button?: { label: string; href: string } } }
const { data: d } = Astro.props;
---
<section class="section-padding dlt-prose">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-4">
        <div class="section-title">
          {d.kicker && <h6 class="sub-title">{d.kicker}</h6>}
          <h2>{d.title}</h2>
        </div>
      </div>
      <div class="col-lg-8">
        {d.lead && <p class="dlt-prose__lead wow fadeInUp">{d.lead}</p>}
        {d.paragraphs.map((p) => <p class="wow fadeInUp">{p}</p>)}
        {d.button && <Button label={d.button.label} href={d.button.href} class="mt-3" />}
      </div>
    </div>
  </div>
</section>
