---
/** Four numbered cards (template: service-section / service-card-item). */
import SectionTitle from '../site/SectionTitle.astro';
interface Props { data: { kicker: string; title: string; intro?: string; cards: { title: string; text: string }[] } }
const { data: d } = Astro.props;
---
<section class="service-section fix section-padding">
  <div class="container">
    <SectionTitle kicker={d.kicker} title={d.title} intro={d.intro} align="center" />
    <div class="row advance-wrap">
      {d.cards.map((c, i) => (
        <div class="col-xl-3 col-lg-4 col-md-6 advance-item">
          <div class="service-card-item">
            <div class="icon"><span class="dlt-num">{String(i + 1).padStart(2, '0')}</span></div>
            <div class="content"><h3>{c.title}</h3><p>{c.text}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
