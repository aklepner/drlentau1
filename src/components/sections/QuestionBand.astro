---
/** Navy band: heading on the left, a list of questions on the right. */
interface Props { data: { kicker?: string; title: string; questions: string[] } }
const { data: d } = Astro.props;
const parts = d.title.split('|').map((s) => s.trim());
---
<section class="section-padding dlt-questions">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-5">
        {d.kicker && <h6 class="sub-title">{d.kicker}</h6>}
        <h2>{parts.map((p, i) => <>{i > 0 && <> <br /></>}{p}</>)}</h2>
      </div>
      <div class="col-lg-7">
        <ol>{d.questions.map((q) => <li class="wow fadeInUp">{q}</li>)}</ol>
      </div>
    </div>
  </div>
</section>
