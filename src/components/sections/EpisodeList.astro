---
/**
 * Podcast episode list. Data: src/data/podcast.json > episodes (newest first).
 * Later: replace the JSON with the podcast RSS feed at build time so new episodes appear automatically.
 */
import SectionTitle from '../site/SectionTitle.astro';
interface Ep { number: number; season: number; title: string; date: string; href: string }
interface Props { data: { kicker?: string; title: string; intro?: string; episodes: Ep[]; more?: { label: string; href: string } } }
const { data: d } = Astro.props;
---
<section class="section-padding dlt-episodes" id="episodes">
  <div class="container">
    <SectionTitle kicker={d.kicker} title={d.title} intro={d.intro} />
    <ol class="dlt-eplist">
      {d.episodes.map((e) => (
        <li>
          <span class="dlt-eplist__num">{e.number}</span>
          <a class="dlt-eplist__title" href={e.href} target="_blank" rel="noopener">{e.title}</a>
          <span class="dlt-eplist__meta">Season {e.season} · {e.date}</span>
        </li>
      ))}
    </ol>
    {d.more && <p class="mt-4"><a class="dlt-link" href={d.more.href} target="_blank" rel="noopener">{d.more.label}</a></p>}
  </div>
</section>
