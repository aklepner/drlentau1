---
/**
 * News + articles from the `news` content collection (src/content/news/*.md), newest first.
 * Posts with `external` link out (old drlentau.com articles not migrated yet); others open /news/<slug>/.
 */
import { getCollection } from 'astro:content';
import SectionTitle from '../site/SectionTitle.astro';
interface Props { kicker?: string; title: string; intro?: string; category?: string; limit?: number }
const { kicker, title, intro, category, limit } = Astro.props;
let posts = (await getCollection('news', (p) => !p.data.draft && (!category || p.data.category === category)))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0) || (a.data.order ?? 999) - (b.data.order ?? 999));
if (limit) posts = posts.slice(0, limit);
const fmt = (d?: Date) => d ? d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '';
---
<section class="section-padding dlt-news">
  <div class="container">
    <SectionTitle kicker={kicker} title={title} intro={intro} />
    <div class="row g-4 mt-2">
      {posts.map((p) => {
        const href = p.data.external || `/news/${p.id}/`;
        const ext = p.data.external ? { target: '_blank', rel: 'noopener' } : {};
        return (
          <div class="col-lg-4 col-md-6">
            <a class="dlt-post" href={href} {...ext}>
              <span class="dlt-tag">{p.data.category}</span>
              {p.data.date && <time>{fmt(p.data.date)}</time>}
              <h3>{p.data.title}</h3>
              {p.data.excerpt && <p>{p.data.excerpt}</p>}
              <span class="dlt-link">Read</span>
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>
