---
/**
 * Posts from Supabase (src/lib/cms.ts), newest first. Each opens /news/<slug>/.
 * `category` shows one category (by name or slug); `exclude` shows every category except that one,
 * so categories Len adds in the admin area appear without code changes.
 */
import { getPosts, fmtDate } from '../../lib/cms';
import SectionTitle from '../site/SectionTitle.astro';
interface Props { kicker?: string; title: string; intro?: string; category?: string; exclude?: string; limit?: number }
const { kicker, title, intro, category, exclude, limit } = Astro.props;
let posts = await getPosts(category);
if (exclude) posts = posts.filter((p) => p.category?.name !== exclude && p.category?.slug !== exclude.toLowerCase());
if (limit) posts = posts.slice(0, limit);
---
{posts.length > 0 && (
<section class="section-padding dlt-news">
  <div class="container">
    <SectionTitle kicker={kicker} title={title} intro={intro} />
    <div class="row g-4 mt-2">
      {posts.map((p) => (
        <div class="col-lg-4 col-md-6">
          <a class="dlt-post" href={`/news/${p.slug}/`}>
            {p.image_url && <img class="dlt-post__img" src={p.image_url} alt={p.image_alt || ''} loading="lazy" />}
            {p.category && <span class="dlt-tag">{p.category.name}</span>}
            {p.published_at && <time>{fmtDate(p.published_at)}</time>}
            <h3>{p.title}</h3>
            {p.excerpt && <p>{p.excerpt}</p>}
            <span class="dlt-link">Read</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
)}
