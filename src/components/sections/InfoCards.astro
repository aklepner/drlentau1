---
/** Three info boxes (template: contact-info-section). No icons, per the design system. */
import SectionTitle from '../site/SectionTitle.astro';
interface Props { intro: { kicker: string; title: string }; cards: { title: string; text: string; link: { label: string; href: string } | null }[] }
const { intro, cards } = Astro.props;
const col = cards.length === 4 ? 'col-xl-3 col-lg-6 col-md-6' : 'col-xl-4 col-lg-6 col-md-6';
---
<section class="contact-info-section fix section-padding">
  <div class="container">
    <SectionTitle kicker={intro.kicker} title={intro.title} align="center" anim="text" />
    <div class="row g-4">
      {cards.map((c, i) => (
        <div class={`${col} wow fadeInUp`} data-wow-delay={`.${3 + i * 2}s`}>
          <div class="contact-info-box dlt-info-box">
            <div class="content">
              <h4>{c.title}</h4>
              <p>{c.text}</p>
              {c.link ? <a class="dlt-link" href={c.link.href} {...(/^https?:/.test(c.link.href) ? { target: '_blank', rel: 'noopener' } : {})}>{c.link.label}</a> : <span class="dlt-soon">Coming soon</span>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
