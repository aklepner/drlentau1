---
/** Scrolling credential strip (template: brand-section / brand-slider). Text only; swap for logos later if wanted. */
interface Props { items: string[] }
const { items } = Astro.props;
---
<div class="brand-section dlt-credentials">
  <div class="swiper brand-slider">
    <div class="swiper-wrapper">
      {items.map((t) => (
        <div class="swiper-slide"><div class="brand-box-1"><span class="dlt-credential">{t}</span></div></div>
      ))}
    </div>
  </div>
</div>
