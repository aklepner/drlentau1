---
/** Navy band of stacked panels under a static title (template: project-section, scrolling marquee removed at Andy's request). Each panel can carry an anchor id. */
import { photo } from '../../lib/photo';
interface Props { data: { kicker?: string; title?: string; items: { id?: string; label: string; title: string; text?: string; photo?: any; video?: string; poster?: string; href?: string; fit?: 'cover' | 'contain'; button?: { label: string; href: string }; buttons?: { label: string; href: string }[]; logo?: { src: string; alt: string; width: number; height: number }; buy?: { label: string; href: string; price?: string } }[] } }
const { data: d } = Astro.props;
// Panel buttons: `buttons` (several), else `buy` when it has a link, else `button`. The first is solid white, the rest outline.
const ctas = (it: any): any[] => it.buttons || (it.buy && it.buy.href ? [it.buy] : it.button ? [it.button] : []);
const ext = (h: string) => (/^https?:/.test(h) ? { target: '_blank', rel: 'noopener' } : {});
---
<section class="project-section tp-project-5-2-area fix section-padding section-bg-2 dlt-panels">
  <div class="container">
    {d.title && (
      <div class="section-title dlt-panels__head">
        {d.kicker && <h6 class="sub-title">{d.kicker}</h6>}
        <h2>{d.title}</h2>
      </div>
    )}
    <div class="project-box-area des-portfolio-wrap">
      {d.items.map((it, i) => {
        const last = i === d.items.length - 1;
        if (it.video) {
          // Video panel: the clip fills the whole panel (muted loop), navy fade on the left for the text.
          return (
            <div id={it.id} class:list={['project-box-items des-portfolio-panel dlt-panel--video', last && 'mb-0']}>
              <video class="dlt-panel__video" src={it.video} poster={it.poster} autoplay muted loop playsinline preload="metadata" aria-label={it.title}></video>
              <div class="dlt-panel__shade" aria-hidden="true"></div>
              {it.logo && <img class="dlt-panel__logo" src={it.logo.src} alt={it.logo.alt} width={it.logo.width} height={it.logo.height} />}
              <div class="content">
                <span>[{it.label}]</span>
                <h3>{it.href ? <a href={it.href} {...ext(it.href)}>{it.title}</a> : it.title}</h3>
                {it.text && <p class="dlt-panel-text">{it.text}</p>}
                {ctas(it).length > 0 && <div class="dlt-panel__cta">{ctas(it).map((b, j) => <a href={b.href} class:list={['dlt-btn', j === 0 ? 'dlt-btn--panel' : 'dlt-btn--on-navy']} {...ext(b.href)}>{b.label}</a>)}{ctas(it)[0].price && <span class="dlt-panel__price">{ctas(it)[0].price}</span>}</div>}
                <div class="dlt-panel__actions">
                  {it.href && <a href={it.href} class="icon" aria-label={it.title} {...ext(it.href)}><i class="fa-solid fa-arrow-up-right"></i></a>}
                  <button type="button" class="dlt-panel__sound" aria-pressed="false"><i class="fa-solid fa-volume-xmark"></i> <span>Sound on</span></button>
                </div>
              </div>
            </div>
          );
        }
        const img = photo(it.photo);
        return (
          <div id={it.id} class:list={['project-box-items des-portfolio-panel', i === d.items.length - 1 && 'mb-0']}>
            <div class="content">
              <span>[{it.label}]</span>
              <h3>{it.href ? <a href={it.href} {...ext(it.href)}>{it.title}</a> : it.title}</h3>
              {it.text && <p class="dlt-panel-text">{it.text}</p>}
              {ctas(it).length > 0 && <div class="dlt-panel__cta">{ctas(it).map((b, j) => <a href={b.href} class:list={['dlt-btn', j === 0 ? 'dlt-btn--panel' : 'dlt-btn--on-navy']} {...ext(b.href)}>{b.label}</a>)}{ctas(it)[0].price && <span class="dlt-panel__price">{ctas(it)[0].price}</span>}</div>}
              {it.href && <a href={it.href} class="icon" aria-label={it.title} {...ext(it.href)}><i class="fa-solid fa-arrow-up-right"></i></a>}
            </div>
            <div class:list={['thumb', it.fit === 'contain' && 'dlt-thumb--contain']}><img src={img.src} alt={img.alt} width={img.width} height={img.height} /></div>
          </div>
        );
      })}
    </div>
  </div>
</section>
<script is:inline>
  document.querySelectorAll('.dlt-panel--video').forEach(function (panel) {
    var v = panel.querySelector('video'), b = panel.querySelector('.dlt-panel__sound');
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); }
    if (!b) return;
    b.addEventListener('click', function () {
      v.muted = !v.muted; if (!v.muted) v.play();
      b.setAttribute('aria-pressed', String(!v.muted));
      b.querySelector('i').className = v.muted ? 'fa-solid fa-volume-xmark' : 'fa-solid fa-volume-high';
      b.querySelector('span').textContent = v.muted ? 'Sound on' : 'Sound off';
    });
  });
</script>
