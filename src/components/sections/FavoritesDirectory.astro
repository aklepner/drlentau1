---
/**
 * Len's Favorites directory. Data: src/data/favorites.json. Each company also gets a detail page
 * at /favorites/<slug>/ (src/pages/favorites/[slug].astro). Category buttons filter the grid (small inline script).
 */
import favorites from '../../data/favorites.json';
const cats = [...new Set(favorites.companies.map((c) => c.category))].sort();
const featured = favorites.companies.filter((c) => c.featured);
---
<section class="section-padding dlt-favs">
  <div class="container">
    <div class="dlt-favs__featured row g-4">
      {featured.map((c) => (
        <div class="col-lg-4">
          <a class="dlt-fav dlt-fav--featured" href={`/favorites/${c.slug}/`}>
            <span class="dlt-tag">{c.category}</span>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
            <span class="dlt-link">Learn more</span>
          </a>
        </div>
      ))}
    </div>
    <div class="dlt-chips dlt-filter mt-5" role="group" aria-label="Filter by category">
      <button type="button" class="is-on" data-cat="all">All</button>
      {cats.map((c) => <button type="button" data-cat={c}>{c}</button>)}
    </div>
    <div class="row g-4 dlt-favs__grid">
      {favorites.companies.map((c) => (
        <div class="col-xl-3 col-lg-4 col-md-6" data-cat={c.category}>
          <a class="dlt-fav" href={`/favorites/${c.slug}/`}>
            <span class="dlt-tag">{c.category}</span>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
<script is:inline>
  document.querySelectorAll('.dlt-filter button').forEach(function (b) {
    b.addEventListener('click', function () {
      var cat = b.getAttribute('data-cat');
      document.querySelectorAll('.dlt-filter button').forEach(function (x) { x.classList.toggle('is-on', x === b); });
      document.querySelectorAll('.dlt-favs__grid [data-cat]').forEach(function (el) {
        el.style.display = cat === 'all' || el.getAttribute('data-cat') === cat ? '' : 'none';
      });
      if (window.ScrollTrigger) ScrollTrigger.refresh();
    });
  });
</script>
