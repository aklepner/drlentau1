---
/** Row of big proof numbers with short labels. */
interface Props { items: { value: string; label: string }[] }
const { items } = Astro.props;
---
<section class="dlt-proofbar">
  <div class="container">
    <ul>{items.map((it) => <li><strong>{it.value}</strong><span>{it.label}</span></li>)}</ul>
  </div>
</section>
