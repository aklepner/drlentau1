---
/** Numbered steps in a row (How it works). */
import SectionTitle from '../site/SectionTitle.astro';
interface Props { data: { kicker?: string; title: string; steps: { title: string; text: string }[] } }
const { data: d } = Astro.props;
---
<section class="section-padding dlt-steps">
  <div class="container">
    <SectionTitle kicker={d.kicker} title={d.title} align="center" />
    <ol class="row g-4">
      {d.steps.map((s, i) => (
        <li class="col-lg-4 wow fadeInUp" data-wow-delay={`.${2 + i * 2}s`}>
          <div class="dlt-step"><span class="dlt-step__num">{String(i + 1).padStart(2, '0')}</span><h3>{s.title}</h3><p>{s.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>
