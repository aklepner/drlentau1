---
/**
 * Section heading in the template's markup (so its GSAP title animation still runs),
 * styled by brand/tau-theme.css as the design system's TauSectionHeader.
 * `title` may contain one `|` to force a line break.
 */
interface Props { kicker?: string; title: string; intro?: string; align?: 'left' | 'center'; class?: string; anim?: 'tz' | 'text' }
const { kicker, title, intro, align = 'left', class: extra = '', anim = 'tz' } = Astro.props;
const parts = title.split('|').map((s) => s.trim());
const h2cls = anim === 'tz' ? 'tx-title sec_title tz-itm-title tz-itm-anim' : 'text-anim';
---
<div class:list={['section-title', align === 'center' && 'text-center', extra]}>
  {kicker && <h6 class="sub-title wow fadeInUp">{kicker}</h6>}
  <h2 class={h2cls}>{parts.map((p, i) => <>{i > 0 && <> <br /></>}{p}</>)}</h2>
  {intro && <p class="mt-3 wow fadeInUp" data-wow-delay=".3s">{intro}</p>}
</div>
