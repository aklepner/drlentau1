---
/**
 * Every page uses this layout. It loads the Brevon template CSS/JS from /public/assets
 * (untouched), then /public/brand/tau-theme.css which re-skins it to the Dr. Len Tau
 * design system. Page sections go in the default slot.
 */
import site from '../data/site.json';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
interface Props { title?: string; description?: string; image?: string }
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | The Reviews Doctor`;
const canonical = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/', site.url).toString();
// Preview builds (GitHub Pages) set PUBLIC_NOINDEX=true so search engines skip the dev copy.
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
const css = ['bootstrap.min', 'all.min', 'animate', 'magnific-popup', 'meanmenu', 'swiper-bundle.min', 'nice-select', 'main'];
const js = ['jquery-3.7.1.min', 'viewport.jquery', 'bootstrap.bundle.min', 'gsap.min', 'ScrollTrigger.min', 'ScrollSmoother.min', 'ScrollToPlugin.min', 'SplitText.min', 'TextPlugin', 'chroma.min', 'jquery.nice-select.min', 'jquery.waypoints', 'jquery.counterup.min', 'swiper-bundle.min', 'jquery.meanmenu.min', 'parallaxie', 'jquery.magnific-popup.min', 'wow.min', 'main'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" />
    {css.map((f) => <link rel="stylesheet" href={`/assets/css/${f}.css`} />)}
    <link rel="stylesheet" href="/brand/tau-theme.css" />
    <slot name="head" />
  </head>
  <body class="dlt">
    <div class="page-wrapper">
      <button id="back-top" class="back-to-top" aria-label="Back to top"><i class="fa-regular fa-arrow-up"></i></button>
      <Header />
      <div id="smooth-wrapper">
        <div id="smooth-content">
          <main><slot /></main>
          <Footer />
        </div>
      </div>
    </div>
    {js.map((f) => <script is:inline src={`/assets/js/${f}.js`}></script>)}
    <script is:inline>
      // Anchor links (/#books) through GSAP ScrollSmoother, which hijacks native scrolling.
      (function () {
        function go(hash, smooth) {
          var el = hash && document.querySelector(hash);
          var s = window.ScrollSmoother && ScrollSmoother.get();
          if (el && s) { s.scrollTo(el, smooth, 'top 90px'); return true; }
          return false;
        }
        window.addEventListener('load', function () { if (location.hash) setTimeout(function () { go(location.hash, false); }, 300); });
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href*="#"]');
          if (!a) return;
          var url = new URL(a.href, location.href);
          if (url.pathname === location.pathname && url.hash && go(url.hash, true)) { e.preventDefault(); history.replaceState(null, '', url.hash); }
        });
      })();
    </script>
  </body>
</html>
