---
/** A single post from Supabase (src/lib/cms.ts). Len writes these in the admin area. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import Button from '../../components/site/Button.astro';
import { getPosts, fmtDate } from '../../lib/cms';
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<BaseLayout title={post.seo_title || post.title} description={post.seo_description || post.excerpt || undefined} image={post.og_image_url || post.image_url || undefined}>
  <PageHeader title="News" />
  <article class="section-padding dlt-article">
    <div class="container">
      {post.category && <span class="dlt-tag">{post.category.name}</span>}{post.published_at && <time>{fmtDate(post.published_at)}</time>}
      <h1>{post.title}</h1>
      {post.author && <p class="dlt-article__byline">By {post.author}</p>}
      {post.image_url && <img class="dlt-article__img" src={post.image_url} alt={post.image_alt || ''} />}
      <div class="dlt-article__body" set:html={post.content_html || ''} />
      <Button label="All News" href="/news/" variant="outline" />
    </div>
  </article>
</BaseLayout>
