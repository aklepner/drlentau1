---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/site/PageHeader.astro';
import Lead from '../components/sections/Lead.astro';
import ProofBar from '../components/sections/ProofBar.astro';
import ProseBlock from '../components/sections/ProseBlock.astro';
import InfoCards from '../components/sections/InfoCards.astro';
import SponsorPackages from '../components/sections/SponsorPackages.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import d from '../data/sponsorship.json';
---
<BaseLayout title={d.seo.title} description={d.seo.description}>
  <PageHeader title="Sponsorship" />
  <Lead data={d.intro} />
  <ProofBar items={d.stats} />
  <ProseBlock data={d.why} />
  <Lead data={d.event} tint />
  <InfoCards intro={d.gains.intro} cards={d.gains.cards} />
  <SponsorPackages data={d.packages} />
  <ProseBlock data={d.guidelines} />
  <CtaBand data={d.cta} />
</BaseLayout>
