---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import CredentialStrip from '../components/sections/CredentialStrip.astro';
import NumberedCards from '../components/sections/NumberedCards.astro';
import AboutIntro from '../components/sections/AboutIntro.astro';
import CardSlider from '../components/sections/CardSlider.astro';
import StackedPanels from '../components/sections/StackedPanels.astro';
import Quotes from '../components/sections/Quotes.astro';
import ProcessAccordion from '../components/sections/ProcessAccordion.astro';
import WordMarquee from '../components/sections/WordMarquee.astro';
import CardGrid from '../components/sections/CardGrid.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import PathCards from '../components/sections/PathCards.astro';
import Recognition from '../components/sections/Recognition.astro';
import PromoSplit from '../components/sections/PromoSplit.astro';
import home from '../data/home.json';
import { getEpisodes, fmtDate } from '../lib/cms';
// Latest three episodes from Supabase, each linking to its own /podcast/<slug>/ page.
const episodes = { ...home.episodes, items: (await getEpisodes()).slice(0, 3).map((e) => ({ title: e.title, href: `/podcast/${e.slug}/`, date: fmtDate(e.published_at), tag: e.number ? `Episode ${e.number}` : 'Episode' })) };
---
<BaseLayout title={home.seo.title} description={home.seo.description} bookReview>
  <Hero data={home.hero} />
  <CredentialStrip items={home.credentials} />
  <PathCards data={home.paths} />
  <NumberedCards data={home.problem} />
  <AboutIntro data={home.about} />
  <Recognition data={home.recognition} />
  <CardSlider data={home.pillars} />
  <PromoSplit data={home.removal} id="review-removal" />
  <StackedPanels data={home.panels} />
  <Quotes data={home.quotes} />
  <ProcessAccordion data={home.process} />
  <WordMarquee words={home.marquee} />
  <CardGrid data={episodes} id="episodes" />
  <CtaBand data={home.cta} />
</BaseLayout>
