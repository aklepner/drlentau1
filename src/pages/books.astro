---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/site/PageHeader.astro';
import BookRows from '../components/sections/BookRows.astro';
import InfoCards from '../components/sections/InfoCards.astro';
import InquiryForm from '../components/sections/InquiryForm.astro';
import d from '../data/books.json';
---
<BaseLayout title={d.seo.title} description={d.seo.description} bookReview>
  <PageHeader title="Books" />
  <BookRows items={d.items} />
  <InfoCards intro={d.tools.intro} cards={d.tools.cards} />
  <InquiryForm data={d.bulk} id="bulk" tint />
</BaseLayout>
